pipeline {
    agent any
    tools {
        maven 'maven-3.9.11'        // Jenkins Tool Name
        jdk 'jdk17'             // Jenkins Tool Name
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/devsecopsmahesh-hue/sample-mavenproject.git'
            }
       
        }
    stage('Clean') {
            steps {
                sh 'mvn clean'
            }
        }

        stage('Compile') {
            steps {
                sh 'mvn compile'
            }
        }
        stage('Unit Test') {
            steps {
                sh 'mvn test'
            }
        }

        stage('Package') {
            steps {
                sh 'mvn package -DskipTests'
            }
        }
    }
}